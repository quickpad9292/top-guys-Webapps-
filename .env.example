# Supabase project "cognithan" (already set in Vercel for all environments)
NEXT_PUBLIC_SUPABASE_URL=https://qryjurpazaldgyilsoue.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: enables AI features (summarize, rewrite, auto-tag, ask your notes).
# Add these in Vercel -> Project -> Settings -> Environment Variables. Never commit keys.
# OpenRouter is used when OPENROUTER_API_KEY is set; otherwise ANTHROPIC_API_KEY (Claude) is used.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models, e.g. anthropic/<model>, openai/<model>, google/<model>.
# Defaults to "openrouter/auto" (OpenRouter picks a model per request).
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
